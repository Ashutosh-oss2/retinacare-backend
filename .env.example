# Server Port
PORT=8000

# Directory containing pre-trained model weights
MODEL_WEIGHTS_DIR=./weights

# Keras PyTorch backend
KERAS_BACKEND=torch

# CORS Allowed Origins (comma-separated list of trusted frontend URLs)
# Example: https://retina-care-frontend-theta.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=https://retina-care-frontend-theta.vercel.app,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# CORS Allowed Origin Regex (for Vercel preview environments)
ALLOW_ORIGIN_REGEX=https://.*\.vercel\.app
